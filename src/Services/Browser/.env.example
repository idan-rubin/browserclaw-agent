# Select a provider and enter credentials per session in the UI or llm_config.

# Server
PORT=5040
BROWSER_INTERNAL_TOKEN=

# Browser
BROWSER_HEADLESS=false
SSRF_ALLOW_PRIVATE=false

# Rate limiting
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=86400000

# MinIO (skill catalog storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=browserclaw-skills

# Session limits
MAX_SESSIONS=10
SESSION_IDLE_TIMEOUT_MS=900000

# Agent timing (ms)
MAX_STEPS=200
WAIT_AFTER_TYPE_MS=2000
WAIT_AFTER_CLICK_MS=1000
WAIT_AFTER_OTHER_MS=500
WAIT_ACTION_MS=2000
USER_RESPONSE_TIMEOUT_MS=300000

# Prompt logging
PROMPT_LOG_DIR=./data/prompts

# Residential proxy (IPRoyal)
IPROYAL_HOST=
IPROYAL_PORT=
IPROYAL_USERNAME=
IPROYAL_PASSWORD=
RESIDENTIAL_DOMAINS=

ENABLE_USER_INTERJECTION=true
